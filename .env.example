# ── Flask ─────────────────────────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production; the app refuses to start otherwise.
SECRET_KEY=change-me

# development | production
#   production → Secure session cookies + HSTS (requires HTTPS, as on Render)
APP_ENV=development

# ── Database (Supabase pooler URI) ─────────────────────────────────────────
# Form: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# URL-encode special characters in the password (@ → %40). sslmode=require is added automatically.
# REQUIRED. Set this in the Render dashboard; never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Max pooled connections per worker. Keep >= threads per worker and under
# Supabase's ceiling: workers × threads.
DB_POOL_MAX=8

# ── Money ──────────────────────────────────────────────────────────────────
# Your net share of order value, e.g. 0.8 = 80%.
COMMISSION_RATE=0.8
